# Copy to .env.local (git-ignored) and fill in.
#
# The live agent on /demo needs one key. Everything else on the site — every
# page, the diagram, the trace — is static and works without it.
#
# Free key: https://aistudio.google.com/apikey
# Server-side only. It is read in lib/agent/llm.ts, which only ever runs in a
# route handler, so it is never sent to the browser. Do not prefix it with
# NEXT_PUBLIC_ — that would publish it.
GEMINI_API_KEY=

# Optional. Defaults to gemini-flash-latest, which still has free-tier quota;
# pinned names like gemini-2.0-flash were zeroed for new projects.
# GEMINI_MODEL=gemini-flash-latest

# WITHOUT A KEY the demo does not break. /api/agent falls back to searching the
# MDX corpus directly and says so — a worse answer, still a true one, and never
# a dead button in front of a recruiter.

# ── voice (optional) ────────────────────────────────────────────────────
# Without this the agent speaks with the browser's own voice, which is free
# and sounds it. With it, /api/speak proxies Cartesia and the reply is spoken
# properly. Server-side only — never prefix with NEXT_PUBLIC_.
CARTESIA_API_KEY=
# Defaults to the voice carried over from the production agent.
# CARTESIA_VOICE_ID=71a7ad14-091c-4e8e-a314-022ece01c121
# CARTESIA_MODEL=sonic-3

# ── calendar (optional) ─────────────────────────────────────────────────
# With these four set, the agent reads real availability and books real
# meetings; Google emails the invitation from the account that owns the
# calendar. Without them it falls back to drafting a message you send.
#
# Setup, once:
#   1. console.cloud.google.com -> new project -> enable Google Calendar API
#   2. OAuth consent screen -> External -> add your Gmail as a test user
#   3. Credentials -> OAuth client ID -> Web application
#      redirect URI: http://localhost:5710/callback
#   4. paste the id and secret below, then: node scripts/google-token.mjs
#   5. make a separate "Demo bookings" calendar and copy its Calendar ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# Working hours the slots are generated from, on your clock. A close hour
# past 24 crosses midnight: the default 10 -> 28 means 10:00 until 04:00
# the next morning. Closed days are matched by the day the window STARTS.
# BOOKING_TIMEZONE=Asia/Karachi
# BOOKING_OPEN_HOUR=10
# BOOKING_CLOSE_HOUR=28
# BOOKING_SLOT_MINUTES=30
# BOOKING_CLOSED_DAYS=Sun
# BOOKING_HOST_EMAIL=you@example.com   # where your copy of the invite goes
